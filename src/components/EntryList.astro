---
import { href } from '../lib/url';
import type { Entry } from '../content/journal';
const { entries } = Astro.props as {entries: Entry[]};
---
<ol class="entry-list">
  {entries.map((entry) => (
    <li>
      <a class="entry-row" href={href(`gunluk/${entry.slug}/`)}>
        <div><span class="entry-date">{entry.target} hedefi</span><span class="entry-stage">{entry.stage}</span></div>
        <strong>{entry.title}</strong>
        <span class="entry-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>
