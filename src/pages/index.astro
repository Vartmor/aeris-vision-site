---
import Base from '../layouts/Base.astro';
import HeroCopy from '../components/HeroCopy';
import HeroScene from '../components/HeroScene';
import SceneCompare from '../components/SceneCompare';
import EntryList from '../components/EntryList.astro';
import { journal, latest } from '../content/journal';
import { href } from '../lib/url';

const metrics = [
  { label: 'Piksel lokalizasyon F1', display: '0,778', fill: 77.8 },
  { label: 'Bire bir bina yakalama oranı', display: '%61,7', fill: 61.7 },
  { label: 'Hasar F1 · Tahmin edilen sınırlarla', display: '0,090', fill: 9.0 },
  { label: 'Hasar F1 · Gerçek sınırlarla', display: '0,118', fill: 11.8 },
];
---
<Base title="AERIS VISION · Field Archive" description="Uydu görüntüleriyle afet sonrası bina hasarını araştıran AERIS VISION projesinin görsel günlüğü." home>
  <section class="hero" data-aeris-theme="dark" data-enter aria-label="AERIS VISION">
    <HeroScene image={href('media/river-valley.webp')} client:load />
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <HeroCopy journalUrl={href('gunluk/')} client:load />
      <div class="hero-foot">
        <a href={href('gunluk/m0-cekirdek/')}><span class="annotation-square" aria-hidden="true"></span> M0 · Çalışan çekirdek</a>
        <span>Temsili uydu görseli</span>
      </div>
    </div>
  </section>

  <section class="section archive-section" id="gunluk" aria-labelledby="archive-title">
    <div class="wrap">
      <div class="section-heading">
        <div><p class="eyebrow">Saha notları</p><h2 id="archive-title">Geliştirme günlüğü</h2></div>
        <a class="text-link" href={href('gunluk/')}>Tüm yazılar <span aria-hidden="true">↗</span></a>
      </div>
      <div class="archive-grid">
        <a class="feature-article" href={href(`gunluk/${latest.slug}/`)}>
          <div class="feature-top"><span>{latest.stage}</span><span>{latest.target} hedefi</span></div>
          <h3>{latest.title}</h3>
          <p>{latest.intro}</p>
          <div class="feature-bottom"><span>Raporu oku</span><span class="feature-arrow" aria-hidden="true">↗</span></div>
        </a>
        <EntryList entries={journal.slice(1)} />
      </div>
    </div>
  </section>

  <section class="section method-section" id="yontem" aria-labelledby="method-title" data-aeris-theme="dark">
    <div class="wrap">
      <div class="section-heading">
        <div><p class="eyebrow">Yöntem</p><h2 id="method-title">Görüntüden bina adayına</h2></div>
      </div>
      <div class="method-grid">
        <div class="method-copy">
          <p class="method-lead">Önce binanın yerini buluyor, sonra afet sonrası görüntüdeki görünür hasarı inceliyoruz.</p>
          <dl class="method-steps">
            <div><dt>Bina sınırı</dt><dd>U-Net, afet öncesi görüntüde bina piksellerini bulur.</dd></div>
            <div><dt>Hasar sınıfı</dt><dd>ResNet18, adayın afet sonrası kırpımını dört sınıfta değerlendirir.</dd></div>
            <div><dt>Doğrulama</dt><dd>Adayları gerçek bina sınırlarıyla eşleştirip kaçırılan ve birleşen binaları sayarız.</dd></div>
          </dl>
        </div>
        <SceneCompare image={href('media/field-scene.webp')} compactImage={href('media/field-scene-724.webp')} client:visible />
      </div>
    </div>
  </section>

  <section class="section result-section" id="sonuclar" aria-labelledby="results-title">
    <div class="wrap">
      <div class="section-heading">
        <div><p class="eyebrow">M0 doğrulaması</p><h2 id="results-title">Sonuçlar ve hatalar</h2></div>
        <a class="text-link" href={href('gunluk/uctan-uca/')}>Değerlendirme notu <span aria-hidden="true">↗</span></a>
      </div>
      <p class="section-summary">Ayrılmış Hurricane Florence sahnesindeki 309 görüntüden. Hasar skoru, aynı hedef maskelerle iki ayrı koşulda hesaplandı.</p>
      <div class="result-grid">
        <div>
          <dl class="metric-list">
            {metrics.map(({ label, display, fill }) => (
              <div style={{ '--score-width': `${fill}%` }}>
                <dt>{label}</dt><dd>{display}</dd>
              </div>
            ))}
          </dl>
          <div class="metric-axis" aria-hidden="true"><span>0%</span><span>100%</span></div>
        </div>
        <aside class="field-note" aria-label="Ağır hasarda görülen hata">
          <span class="annotation-square" aria-hidden="true"></span>
          <p class="eyebrow">Ağır hasarda kaçırma</p>
          <p class="note-number"><strong>661</strong> / 1.299</p>
          <p>Ağır hasarlı veya yıkılmış bu binalar hasarsız tahmin edildi. Sonuçlar, insan doğrulaması gerektiren araştırma çıktılarıdır.</p>
        </aside>
      </div>
    </div>
  </section>
</Base>
