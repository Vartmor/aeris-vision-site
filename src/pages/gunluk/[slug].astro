---
import Base from '../../layouts/Base.astro';
import { journal } from '../../content/journal';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return journal.map((entry, index) => ({
    params: { slug: entry.slug },
    props: { entry, newer: journal[index - 1], older: journal[index + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
---

<Base title={`${entry.number}. ${entry.title}`} description={entry.intro}>
  <article class="wrap reading-column">
    <header class="page-intro article-intro">
      <a class="text-link page-back" href={href('gunluk/')}>← Proje günlüğü</a>
      <h1><span class="article-number">{entry.number}.</span> {entry.title}</h1>
      <p>{entry.intro}</p>
    </header>
    <div class="prose">
      {entry.sections.map(({ title, paragraphs, figure, code }) => (
        <section>
          <h2>{title}</h2>
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {code && <pre><code>{code}</code></pre>}
          {figure && (
            <figure class="article-figure">
              <img src={href(`media/gunluk/${figure.file}`)} alt={figure.alt}
                   width={figure.size?.width ?? 1008} height={figure.size?.height ?? 576}
                   loading="lazy" decoding="async" />
              <figcaption>
                {figure.caption}
                <a href={href(`media/gunluk/${figure.file}`)}>Grafiği büyüt</a>
              </figcaption>
            </figure>
          )}
        </section>
      ))}
    </div>
    <nav class="article-neighbours" aria-label="Diğer yazılar">
      {older && <a href={href(`gunluk/${older.slug}/`)}><small>← Önceki yazı</small><strong>{older.number}. {older.title}</strong></a>}
      {newer && <a href={href(`gunluk/${newer.slug}/`)}><small>Sonraki yazı →</small><strong>{newer.number}. {newer.title}</strong></a>}
    </nav>
  </article>
</Base>
